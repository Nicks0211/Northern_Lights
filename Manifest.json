{
  "manifest_version": 3,
  "name": "NEXUS Floating AI",
  "version": "1.0",
  "description": "Painel flutuante futurista com IA",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "action": {
    "default_title": "NEXUS AI"
  }
}